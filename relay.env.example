# Required. Admin password for the web UI; the relay refuses to start
# without it (min 12 chars) so a fresh deploy is never wide open.
RELAY_ADMIN_TOKEN=change-me-to-something-long

# Listen address inside the container.
RELAY_ADDR=:8080

# ASR and Blinko are configured in the web UI on first run. The values below
# only seed that form, so an existing deployment keeps working after upgrade.
ASR_BASE=http://host.docker.internal:11434
ASR_MODEL=frozenlab/qwen3-asr:1.7b
BLINKO_BASE=
BLINKO_TOKEN=

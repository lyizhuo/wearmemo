# Shared secret between the watch and the relay.
# Set the same value in app/build.gradle.kts -> DEVICE_TOKEN.
RELAY_DEVICE_TOKEN=change-me

# Blinko on the same docker network (internal, no TLS needed).
BLINKO_BASE=http://blinko-website:1111
# Copy from Blinko: Settings -> 账户 -> 访问令牌 (apiToken).
BLINKO_TOKEN=

# Qwen3-ASR served by vLLM. Only 1.7B and 0.6B exist.
ASR_BASE=http://host.docker.internal:8000
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
